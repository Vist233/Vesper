async function tick(){
  try{
    const r = await fetch('/state',{cache:'no-store'}); const s = await r.json();
    document.getElementById('dot').className = 'dot ' + (s.ok?'ok':'bad');
    document.getElementById('st').textContent = s.ok ? ('正常 · ' + s.capture.fps_measured + ' fps')
                                                    : ('异常 · ' + (s.health.reasons||[]).join(','));
