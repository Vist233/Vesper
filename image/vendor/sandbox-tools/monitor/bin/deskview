      (s.resolution.display||'') + ' · 帧 #' + s.capture.frames_total +
      ' · 延迟 ' + (s.last_frame.age_sec==null?'-':s.last_frame.age_sec.toFixed(2)+'s');
  }catch(e){ document.getElementById('dot').className='dot bad'; document.getElementById('st').textContent='状态接口不可达'; }
}
tick(); setInterval(tick, 2000);
</script>
</body></html>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "deskview/" + VERSION
    protocol_version = "HTTP/1.1"

    # -- 认证 -------------------------------------------------------------- #
    def _authorized(self):
        cfg = self.server.cfg
        if not cfg.auth and not cfg.token:
            return True
        u = urlparse(self.path)
        qs = parse_qs(u.query)
        if cfg.token:
            got = (qs.get("token", [""])[0]) or self.headers.get("X-Desk-Token", "")
            if got and hmac.compare_digest(str(got), str(cfg.token)):
                return True
        if cfg.auth:
            h = self.headers.get("Authorization", "")
            if h.startswith("Basic "):
                try:
                    raw = base64.b64decode(h[6:]).decode("utf-8", "replace")
                except Exception:  # noqa: BLE001
                    raw = ""
                if hmac.compare_digest(raw, cfg.auth):
                    return True
        return False

    def _deny(self):
        body = b"401 unauthorized\n"
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="deskview"')
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, ctype, body, extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store, no-cache, must-revalidate")
        self.send_header("Content-Length", str(len(body)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    # -- 路由 -------------------------------------------------------------- #
    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        srv = self.server
        cfg = srv.cfg
        if not self._authorized():
            return self._deny()
        path = urlparse(self.path).path

        if path in ("/", "/index.html"):
            novnc = ""
            if cfg.novnc_port:
                novnc = ('<a href="http://%s:%d/vnc.html?autoconnect=1&resize=scale" '
                         'target="_blank">→ 需要操作（noVNC）</a>'
                         % (self.headers.get("Host", "127.0.0.1").split(":")[0], cfg.novnc_port))
            html = (PAGE.replace("__DISPLAY__", cfg.display)
                        .replace("__TITLE__", cfg.title)
                        .replace("__NOVNC__", novnc))
            return self._send(200, "text/html; charset=utf-8", html)

        if path == "/stream.mjpg":
            return self._stream()

        if path == "/snap.jpg":
            frame, seq, ts, nb, _w, _h = srv.grab.snapshot()
            if not frame:
                return self._send(503, "text/plain; charset=utf-8", "no frame yet\n")
            return self._send(200, "image/jpeg", frame, {"X-Frame-Seq": str(seq)})

        if path == "/state":
            st = build_state(cfg, srv.grab, srv.probe, srv.clients)
            return self._send(200, "application/json; charset=utf-8",
                              json.dumps(st, ensure_ascii=False, indent=1) + "\n")

        if path == "/healthz":
            st = build_state(cfg, srv.grab, srv.probe, srv.clients)
            return self._send(200 if st["ok"] else 503, "application/json; charset=utf-8",
                              json.dumps({"ok": st["ok"], "reasons": st["health"]["reasons"]}) + "\n")

        if path == "/metrics":
            return self._send(200, "text/plain; version=0.0.4; charset=utf-8", self._metrics())

        return self._send(404, "text/plain; charset=utf-8", "not found\n")

    def _metrics(self):
        srv = self.server
        st = build_state(srv.cfg, srv.grab, srv.probe, srv.clients)
        g = srv.grab
        lines = [
            "# HELP deskview_frames_total 累计解码帧数",
            "# TYPE deskview_frames_total counter",
            "deskview_frames_total %d" % st["capture"]["frames_total"],
            "# HELP deskview_fps 近 5 秒实测帧率",
            "# TYPE deskview_fps gauge",
            "deskview_fps %.3f" % st["capture"]["fps_measured"],
            "# HELP deskview_frame_age_seconds 最近一帧年龄",
            "# TYPE deskview_frame_age_seconds gauge",
            "deskview_frame_age_seconds %.3f" % (st["last_frame"]["age_sec"] or 0),
            "# HELP deskview_up 采集是否健康",
            "# TYPE deskview_up gauge",
            "deskview_up %d" % (1 if st["ok"] else 0),
            "# HELP deskview_restarts_total 采集进程重启次数",
            "# TYPE deskview_restarts_total counter",
            "deskview_restarts_total %d" % g.restarts,
            "# HELP deskview_last_frame_bytes 最近一帧字节数",
            "# TYPE deskview_last_frame_bytes gauge",
            "deskview_last_frame_bytes %d" % st["capture"]["last_frame_bytes"],
            "# HELP deskview_windows 探测到的窗口数",
            "# TYPE deskview_windows gauge",
            "deskview_windows %d" % len(st["windows"]),
        ]
        return "\n".join(lines) + "\n"

    def _stream(self):
        srv = self.server
        cfg = srv.cfg
        self.close_connection = True
        self.send_response(200)
        self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=frame")
        self.send_header("Cache-Control", "no-store, no-cache, must-revalidate, private")
        self.send_header("Pragma", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        last = -1
        with srv.lock:
            srv.clients["active"] += 1
        try:
            while True:
                frame, seq, _ts, _nb, _w, _h = srv.grab.snapshot()
                if frame is None:
                    time.sleep(0.1)
                    continue
                if seq == last:
                    time.sleep(0.02)
                    continue
                head = ("--frame\r\nContent-Type: image/jpeg\r\nContent-Length: %d\r\n"
                        "X-Frame-Seq: %d\r\n\r\n" % (len(frame), seq)).encode()
                self.wfile.write(head)
                self.wfile.write(frame)
                self.wfile.write(b"\r\n")
                self.wfile.flush()
                last = seq
                time.sleep(max(0.0, 1.0 / cfg.fps - 0.01))
        except Exception:  # noqa: BLE001  客户端断开
            return
        finally:
            with srv.lock:
                srv.clients["active"] = max(0, srv.clients["active"] - 1)


# --------------------------------------------------------------------------- #
# main
# --------------------------------------------------------------------------- #
def parse_auth(s):
    if not s:
        return None
    if ":" not in s:
        sys.exit("--auth 需要 user:password 形式")
    return s


def main():
    ap = argparse.ArgumentParser(
        description="X 桌面 MJPEG 直播 + 结构化状态接口",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例：
  deskview --display :98 --port 6084
  deskview --container agent-desktop --display :98 --port 6084 --size 1920x1080
  deskview --display :97 --bind 0.0.0.0 --auth monitor:secret""")
    ap.add_argument("--display", default=":98", help="X 显示号，默认 :98")
    # nargs="?" ：systemd 里 --container ${DESK_CONTAINER} 在变量为空时不会报错，等同本机模式
    ap.add_argument("--container", nargs="?", const="", default="",
                    help="容器名；给了就进容器抓屏，省略=本机 X")
    ap.add_argument("--port", type=int, default=6084, help="HTTP 端口，默认 6084")
    ap.add_argument("--bind", default="127.0.0.1", help="监听地址，默认 127.0.0.1")
    ap.add_argument("--size", default="auto", help="采集分辨率 WxH 或 auto（默认自动探测）")
    ap.add_argument("--fps", type=int, default=6, help="采集帧率，默认 6")
    ap.add_argument("--scale", type=int, default=1440, help="输出宽度，0=不缩放，默认 1440")
    ap.add_argument("--quality", type=int, default=5, help="MJPEG 质量 2(最好)-31(最差)，默认 5")
    ap.add_argument("--state-dir", default="~/.local/state/deskview",
                    help="状态目录（latest.jpg/pid），默认 ~/.local/state/deskview")
    ap.add_argument("--snapshot-interval", type=float, default=1.0,
                    help="latest.jpg 落盘间隔秒，0=关闭，默认 1")
    ap.add_argument("--novnc", type=int, default=0, help="noVNC 端口，给了页面就显示接管链接")
    ap.add_argument("--title", default="桌面直播", help="页面标题")
    ap.add_argument("--auth", default=os.environ.get("DESKVIEW_AUTH", ""),
                    help="HTTP Basic 认证 user:pass（也可用 $DESKVIEW_AUTH）")
    ap.add_argument("--token", default=os.environ.get("DESKVIEW_TOKEN", ""),
                    help="URL token（?token=... 或 X-Desk-Token 头）")
    ap.add_argument("--ffmpeg", default="", help="ffmpeg 路径（默认自动找/或 $FFMPEG）")
    ap.add_argument("--docker", default="", help="docker 客户端路径（默认自动探测）")
    ap.add_argument("--container-ffmpeg", default="ffmpeg", help="容器内 ffmpeg 路径")
    ap.add_argument("--pid-file", default="", help="写自身 pid 的文件（方便外部重启）")
    ap.add_argument("--no-self-heal", dest="self_heal", action="store_false",
                    help="关闭内部冻结看门狗（交给外部 deskguard 统一重启时用，避免两级重启打架）")
    ap.add_argument("--version", action="version", version="deskview " + VERSION)
    a = ap.parse_args()

    if not re.match(r"^:\d+$", a.display):
        sys.exit("--display 需形如 :98（当前：%r）" % a.display)
    a.auth = parse_auth(a.auth)

    os.makedirs(os.path.expanduser(a.state_dir), exist_ok=True)
    cfg = Cfg(a)

    ff = find_ffmpeg(a.ffmpeg)
    docker = None
    if cfg.mode == "container":
        docker = find_docker(a.docker)
        if not docker:
            sys.exit("找不到可用的 docker 客户端（试试 --docker /path/to/docker 或 $DOCKER；exit 2）")
        r = run([docker, "inspect", "-f", "{{.State.Running}}", cfg.container], timeout=20)
        if r.returncode != 0 or "true" not in (r.stdout or "").lower():
            sys.exit("容器 %s 不存在或未运行：%s" % (cfg.container, (r.stderr or "").strip()[:200]))
    else:
        if not ff:
            sys.exit("找不到 ffmpeg（安装 ffmpeg 或用 --ffmpeg/$FFMPEG 指定）")
        r = run(["/bin/sh", "-c", "DISPLAY=%s timeout 5 xdpyinfo >/dev/null 2>&1"
                 % shlex.quote(cfg.display)], timeout=8)
        if r.returncode != 0:
            log("警告：%s 现在探测不到（x11vnc/Xvfb 可能还没起）" % cfg.display)

    probe = Probe(cfg, docker)
    probe.probe_size()
    if cfg.size in ("auto", "", None):
        cfg.size = probe.display_size or "1920x1080"
        if probe.display_size:
            log("自动分辨率：%s" % cfg.size)
    probe.start()

    grab = Grabber(cfg, ff or "ffmpeg", docker)
    grab.start()

    if cfg.bind not in ("127.0.0.1", "localhost", "::1") and not (cfg.auth or cfg.token):
        log("警告：监听 %s 且未设置 --auth/--token，任何能连到该端口的人都能看屏幕" % cfg.bind)

    srv = ThreadingHTTPServer((cfg.bind, cfg.port), Handler)
    srv.daemon_threads = True
    srv.cfg = cfg
    srv.grab = grab
    srv.probe = probe
    srv.lock = threading.Lock()
    srv.clients = {"active": 0}

    # latest.jpg 落盘线程
    def snapshotter():
        path = os.path.join(cfg.state_dir, "latest.jpg")
        while not grab.stopped():
            if cfg.snapshot_interval > 0:
                frame, _seq, _ts, _nb, _w, _h = grab.snapshot()
                if frame:
                    try:
                        write_snapshot(path, frame)
                    except Exception as exc:  # noqa: BLE001
                        log("快照写入失败：%s" % exc)
            time.sleep(max(0.2, cfg.snapshot_interval))

    if cfg.snapshot_interval > 0:
        threading.Thread(target=snapshotter, daemon=True).start()

    # 采集冻结看门狗（进程活着但没帧）
    def watchdog():
        while not grab.stopped():
            time.sleep(1.0)
            _f, _s, ts, _nb, _w, _h = grab.snapshot()
            # 拿"最后一帧"和"进程启动"里较晚的那个算冻结，避免刚重启还没出帧就被再杀一次
            ref = max(ts, grab.proc_started)
            if ref and time.time() - ref > cfg.stale_sec:
                log("看门狗：%.0fs 无新帧，重启采集" % (time.time() - ref))
                grab._kill()

    if a.self_heal:
        threading.Thread(target=watchdog, daemon=True).start()
    else:
        log("已关闭内部看门狗（--no-self-heal），冻结恢复由外部 supervisor 负责")

    if cfg.pid_file:
        with open(cfg.pid_file, "w") as f:
            f.write(str(os.getpid()))

    def shutdown(*_a):
        log("退出")
        grab.stop_evt.set()
        grab._kill()
        probe.stop_evt.set()
        if cfg.pid_file and os.path.exists(cfg.pid_file):
            try:
                os.unlink(cfg.pid_file)
            except OSError:
                pass
        os._exit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    log("v%s %s 模式 display=%s size=%s fps=%d -> http://%s:%d/"
        % (VERSION, cfg.mode, cfg.display, cfg.size, cfg.fps, cfg.bind, cfg.port))
    try:
        srv.serve_forever(poll_interval=0.5)
    finally:
        shutdown()


if __name__ == "__main__":
    main()
